# Copy to .env for docker compose.
# Docker Compose uses MYSQL_* for both the database container and the application.

# MySQL
MYSQL_DATABASE=mxxssm_admin
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=mxxssm
MYSQL_PASSWORD=change-me
MYSQL_PORT=3307

# Application
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8081
SPRINGDOC_ENABLED=false

# Direct jar deployment (outside Docker Compose) uses these instead:
# DB_URL='jdbc:mysql://localhost:3306/mxxssm_admin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true'
# DB_USERNAME=root
# DB_PASSWORD=change-me
